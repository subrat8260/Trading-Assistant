{
  "name": "trading-assistant-server",
  "version": "1.0.0",
  "description": "Trading Assistant Backend API with Clean Architecture",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "build": "pip install -r requirements.txt || pip install openpyxl",
    "dev": "nodemon server.js",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix",
    "format": "prettier --write \"src/**/*.js\""
  },
  "keywords": [
    "trading",
    "express",
    "mongoose",
    "clean-architecture",
    "mern"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios-cookiejar-support": "^7.0.0",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.2.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.4.1",
    "morgan": "^1.10.0",
    "pdfkit": "^0.19.1",
    "tough-cookie": "^6.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "nodemon": "^3.1.3",
    "prettier": "^3.3.1"
  }
}
